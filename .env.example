# Copy only when .env does not already exist; never overwrite an existing key.
OPENAI_API_KEY=
# API remains the default. codex-cli uses separately authenticated Codex account.
DIALOGUE_PROVIDER=api
CODEX_MODEL=gpt-5.6-luna
# Native codex executable; Windows .cmd/.ps1 wrappers are not supported.
# CODEX_CLI_PATH=C:\path\to\codex.exe
CODEX_TIMEOUT_MS=120000
# Native subscription-backed search, independent of OPENAI_WEB_SEARCH and API quota ledger.
CODEX_WEB_SEARCH=true
# Our own local client password, at least 32 random characters. Not a hardware token.
G2_CLIENT_TOKEN=
# Soniox is the default when SONIOX_API_KEY is present. Set STT_PROVIDER=openai
# only to use the retained OpenAI fallback adapter.
STT_PROVIDER=soniox
SONIOX_API_KEY=
SONIOX_TRANSCRIBE_MODEL=stt-rt-v5
OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
# Used only by the retained OpenAI STT fallback cost meter.
OPENAI_TRANSCRIBE_USD_PER_MINUTE=0.017
# Legacy OPENAI_DIALOGUE_MODEL remains a fallback for both roles.
OPENAI_INTENT_MODEL=gpt-5.6-luna
# Experimental hybrid: set OPENAI_REPLY_MODEL=gpt-5-nano, then restart.
OPENAI_REPLY_MODEL=gpt-5.6-luna
PORT=3000
CONVERSATION_PORT=3001
# Optional production ingress. The Node service still listens on 127.0.0.1;
# a TLS reverse proxy is the only public listener.
# EVEN_PUBLIC_HOST=calendar.eveng2assistant.com
# EVEN_PUBLIC_ORIGIN=https://calendar.eveng2assistant.com
# Persistent jobs/artifacts/conversations; keep separate from the code and Codex auth.
EVEN_DATA_DIR=.local
OPENAI_WEB_SEARCH=true
# Built-in web-search calls: per answer, per 30-minute conversation session,
# per Chicago calendar day, and per calendar month. These are application
# safety limits, not the OpenAI project-wide USD spend limit.
OPENAI_MAX_SEARCH_CALLS=10
OPENAI_SEARCH_SESSION_LIMIT=50
OPENAI_SEARCH_DAILY_LIMIT=100
OPENAI_SEARCH_MONTHLY_LIMIT=1200
CONVERSATION_TIMEZONE=America/Chicago
# Logical sessions remain resumable for at most 15 minutes after disconnect.
SESSION_RESUME_WINDOW_MINUTES=15
# Ended/expired conversation sessions are retained for three years by default.
# Set 0 only when you explicitly want to disable automatic conversation cleanup.
SESSION_RETENTION_DAYS=1095
# Metadata-only storage warnings. They never trigger deletion by themselves.
SESSION_DATABASE_WARNING_MB=1024
SESSION_DISK_FREE_WARNING_MB=2048
# API mode only. Defaults to OPENAI_REPLY_MODEL and uses the same metered
# OpenAI fetch; summaries never receive web, Calendar, or Email tools.
# SESSION_SUMMARY_MODEL=
# Persistent application-level monthly cost ledger. The $80 provider budget is
# separate from Lightsail/domain/snapshot infrastructure. The provider caps add
# up exactly to the total cap. Accounting months and Google free-SKU resets use
# America/Los_Angeles, matching Google Maps Platform's documented reset boundary.
COST_TOTAL_MONTHLY_USD=80
COST_OPENAI_MONTHLY_USD=50
COST_SONIOX_MONTHLY_USD=20
COST_GOOGLE_MONTHLY_USD=10
# Defaults below are for gpt-5.6-luna Standard pricing verified 2026-09-19.
# Review them against official OpenAI pricing before changing the API model.
OPENAI_INPUT_USD_PER_M=0.20
OPENAI_CACHED_INPUT_USD_PER_M=0.02
OPENAI_CACHE_WRITE_USD_PER_M=0.25
OPENAI_OUTPUT_USD_PER_M=1.20
OPENAI_WEB_SEARCH_USD_PER_CALL=0.01
# Optional server-side route/environment provider. Use a dedicated Maps key
# restricted to the six reviewed APIs and the calling machine/server IP. Never put
# this key in clients/even, app.json, or an .ehpk.
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=
# Calendar local-time resolution uses Google Time Zone first. If it stays
# unavailable, the existing OpenAI API model receives only bounded dialogue and
# a validated device IANA-zone hint (no coordinates) and must resolve or ask once.
# Structured Weather, Air Quality and Pollen evidence. The key must stay on the
# server and be restricted to the three APIs plus the server/test-machine IP.
# GOOGLE_ENVIRONMENT_API_KEY may be omitted to reuse GOOGLE_MAPS_API_KEY when
# that key's API restrictions explicitly include all six required Google APIs.
GOOGLE_ENVIRONMENT_ENABLED=false
# GOOGLE_ENVIRONMENT_API_KEY=
# Retired compatibility flag. Outdoor and itinerary requests now use Luna's
# general planning mode. Structured read tools may fall back to quota-bounded
# web search; Calendar and Email never use a speculative fallback.
EVEN_CONDITIONAL_TASKS_ENABLED=false
# Dedicated Google account only. Defaults to SMTP_USER when omitted.
# GOOGLE_CALENDAR_ACCOUNT=
GOOGLE_CALENDAR_NAME=Even Assistant
# Real calendar operations are opt-in; OAuth authorization alone does not enable writes.
GOOGLE_CALENDAR_ENABLED=false
# Dedicated Gmail sender only. Keep real addresses and credentials in private .env.
EVEN_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
# 465 + true uses implicit TLS; 587 + false requires STARTTLS (never plaintext auth).
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
# The same fixed recipient receives cost alerts. Places Text Search Enterprise
# alerts at 50% and 95% of its monthly free cap; other active Google SKUs alert
# at 95%. Alert state is durable and does not appear on the glasses display.
# API mode only: one bounded, no-search summary request per MD export; false uses excerpts.
EMAIL_AI_SUMMARY=true
# Defaults to OPENAI_INTENT_MODEL when omitted.
# EMAIL_SUMMARY_MODEL=
# API conversation artifact generation; defaults to reply model. No search or execution tools.
# OPENAI_DOCUMENT_MODEL=
