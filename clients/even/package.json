{
  "name": "even-agent-client",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/verify-build.mjs",
    "pack:hub": "npm run build && evenhub pack app.json dist -o glass-assistant-0.2.0.ehpk --sdk-ver 0.0.14",
    "pack:hub:check": "npm run build && evenhub pack app.json dist -o glass-assistant-0.2.0.ehpk --sdk-ver 0.0.14 -c",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.14"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.1.14",
    "@types/node": "22.20.3",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  }
}
