[Unit]
Description=Check protected main for a verified Even Agent update
# Automatic application releases are opt-in; manual update.service is unaffected.
ConditionPathExists=/etc/even-agent/automatic-updates.enabled

[Timer]
OnBootSec=15min
OnUnitActiveSec=6h
RandomizedDelaySec=30min
Persistent=true
Unit=even-agent-update.service

[Install]
WantedBy=timers.target
